{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"buildCommand": "cp dist/index.js site/litfass.js",
	"installCommand": "",
	"outputDirectory": "site",
	"cleanUrls": true,
	"proxy": {
		"entrypoint": "proxy.js",
		"matcher": "/litfass/:path*"
	},
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				},
				{
					"key": "Referrer-Policy",
					"value": "strict-origin-when-cross-origin"
				}
			]
		}
	]
}
