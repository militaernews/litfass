		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "^26.6.11",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"unplugin-icons": "24.0.0",
		"vite": "8.3.8"
	}
